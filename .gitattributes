# Mana Ooru — Git Attributes Configuration
# Standardizes line endings and ensures 3D models, textures, and audio are treated as binary.

# Everything text uses LF, on every OS.
* text=auto eol=lf

# Godot & GDScript source text files
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.svg text eol=lf

# 3D models & assets (binary, never alter line endings)
*.glb binary
*.gltf binary
*.obj binary
*.fbx binary
*.blend binary
*.dae binary
*.usdz binary

# Textures & Images (binary)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.tga binary
*.bmp binary
*.hdr binary
*.exr binary
*.ico binary

# Audio files (binary)
*.wav binary
*.ogg binary
*.mp3 binary
*.flac binary

# Fonts (binary)
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Compiled Godot binary resources and game data
*.res binary
*.scn binary
*.bin binary
*.gz binary
