[input_devices]

sensors/enable_gyroscope=true
pointing/emulate_mouse_from_touch=false

[physics]

3d/default_gravity=18.0
3d/solver/solver_iterations=10
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.38, 0.68, 0.88, 1)
renderer/rendering_method.driver="opengl3"
lights_and_shadows/directional_shadow/size.mobile=1024
scaling_3d/mode=1
scaling_3d/scale.mobile=0.65
scaling_3d/fsr_sharpness=0.2
