[application]
config/name="MANA OORU"
config/description="MANA OORU - 3D Exploration Prototype"
run/main_scene="res://scenes/main.tscn"
config/icon="res://assets/mana_ooru_icon.svg"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/size/resizable=true
window/size/mode=3

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.driver="opengl3"
environment/defaults/default_clear_color=Color(0.38, 0.68, 0.88, 1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[input]
prone={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":90)]}
lean_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":81)]}
lean_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":69)]}
free_look={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194328)]}
