assets/models/panipuri_cart/source/
assets/models/characters/references/Screenshot*
assets/test_only/device_screenshots/
Godavarikhani_Bridge_3D/renders/
Godavarikhani_Bridge_3D/renders_test/

# Temporary work directories, test captures, and local outputs
work/
outputs/

# Python bytecode
__pycache__/
*.pyc

# Output of tools/captures/capture_bridge_frame.gd
bridge_viewport_capture.png
bridge_viewport_capture.png.import

# OS-specific metadata & logs
.DS_Store
Thumbs.db
